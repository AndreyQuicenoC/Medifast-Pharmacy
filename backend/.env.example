# Configuración para desarrollo local y producción
# Copiar este archivo como .env y configurar los valores reales

# Django Settings
# Generar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-random-secret-key
DEBUG=True

# Desarrollo local sin PostgreSQL (SQLite en backend/db.sqlite3)
USE_SQLITE=True

# Base de datos PostgreSQL (Render)
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=replace-with-postgres-password
DB_HOST=your-database-host
DB_PORT=5432

# Render specific
RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com

# Frontend URL (para CORS)
FRONTEND_URL=https://your-frontend-url.com
